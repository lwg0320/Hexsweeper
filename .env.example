# Copy this file to .env and paste your Claude API key after the equals sign.
ANTHROPIC_API_KEY=
HEXSWEEPER_MODEL=claude-haiku-5-5
# Optional: only needed for API keys not scoped to a single workspace.
ANTHROPIC_WORKSPACE_ID=
# Optional dated cost estimate rates, in USD per million tokens for HEXSWEEPER_MODEL.
# Cost remains unknown when these are unset or when a returned cache-token class has no rate.
HEXSWEEPER_INPUT_USD_PER_MILLION=
HEXSWEEPER_OUTPUT_USD_PER_MILLION=
HEXSWEEPER_CACHE_WRITE_USD_PER_MILLION=
HEXSWEEPER_CACHE_READ_USD_PER_MILLION=
HEXSWEEPER_PRICING_AS_OF=
HEXSWEEPER_PRICING_SOURCE=
